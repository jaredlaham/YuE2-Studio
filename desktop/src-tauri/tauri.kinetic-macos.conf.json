{
  "productName": "Kinetic Studio",
  "identifier": "com.kineticfields.kinetic-studio",
  "mainBinaryName": "Kinetic-Studio",
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "create": false,
        "title": "Kinetic Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "resources": {
      "resources/yue2-cpp": "resources/yue2-cpp",
      "resources/music-midi": "resources/music-midi"
    },
    "icon": [
      "icons/kinetic/32x32.png",
      "icons/kinetic/128x128.png",
      "icons/kinetic/128x128@2x.png",
      "icons/kinetic/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": null
  }
}
